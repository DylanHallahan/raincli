# /etc/raincli/raincli.env  (owner root:raincli, mode 0640). Copy, then fill in real values ON THE HOST.
# Never commit the filled-in file. Generate secrets with:  python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
RAINCLI_DATABASE_URL=postgresql+psycopg://raincli:CHANGE_ME@127.0.0.1:5432/raincli
RAINCLI_SECRET_KEY=CHANGE_ME_AT_LEAST_32_BYTES
RAINCLI_PUBLIC_URL=https://raincli.com
RAINCLI_ROOT_PATH=
RAINCLI_COOKIE_SECURE=1
RAINCLI_MAX_PENDING=1000
RAINCLI_RATE_LIMIT_PER_MIN=120
