[Unit]
Description=RainCLI PostgreSQL backup (pg_dump custom format)
After=postgresql.service

[Service]
Type=oneshot
User=raincli
Group=raincli
EnvironmentFile=/etc/raincli/raincli.env
Environment=RAINCLI_BACKUP_DIR=/var/backups/raincli
Environment=RAINCLI_BACKUP_KEEP=14
ExecStart=/opt/raincli/current/deploy/raincli/scripts/backup.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/raincli
UMask=0077
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallFilter=@system-service
CapabilityBoundingSet=
